console.log('🗺️ MapComponent script loaded');

class MapComponent {
    constructor(containerId, parkData = null, userAddress = null) {
        console.log('🗺️ ===== MAP COMPONENT CONSTRUCTOR =====');
        console.log('🗺️ Creating MapComponent for:', containerId);
        console.log('🗺️ Park data provided:', parkData);
        console.log('🗺️ User address provided:', userAddress);
        console.log('🗺️ DOM ready state:', document.readyState);
        
        this.containerId = containerId;
        this.parkData = parkData;
        this.userAddress = userAddress;
        this.mapContainer = document.getElementById(containerId);
        this.markers = []; // Array to store all markers
        this.dropPinMode = false; // Track if drop pin mode is active
        this.droppedPin = null; // Store the dropped pin marker
        this.mapboxAccessToken = 'REDACTED';
        this.routeControl = null; // Store route control for cleanup
        
        console.log('🗺️ Map container element:', this.mapContainer);
        console.log('🗺️ Map container found:', !!this.mapContainer);
        
        if (!this.mapContainer) {
            console.error('❌ Map container not found:', containerId);
            console.error('❌ Available elements with IDs:', 
                Array.from(document.querySelectorAll('[id]')).map(el => el.id)
            );
            return;
        }
        
        console.log('🗺️ Map container dimensions:', {
            offsetWidth: this.mapContainer.offsetWidth,
            offsetHeight: this.mapContainer.offsetHeight,
            clientWidth: this.mapContainer.clientWidth,
            clientHeight: this.mapContainer.clientHeight,
            innerHTML: this.mapContainer.innerHTML
        });
        
        // Add debugging for distance elements at initialization
        const travelTimeEl = document.getElementById('travelTime');
        const drivingDistanceEl = document.getElementById('drivingDistance');
        console.log('🗺️ Distance elements check at init:');
        console.log('🗺️ - travelTime element:', !!travelTimeEl);
        console.log('🗺️ - drivingDistance element:', !!drivingDistanceEl);
        
        this.createMap();
    }

    createMap() {
        console.log('🗺️ ===== CREATE MAP =====');
        console.log('🗺️ Creating map...');
        console.log('🗺️ Container dimensions:', {
            width: this.mapContainer.offsetWidth,
            height: this.mapContainer.offsetHeight,
            clientWidth: this.mapContainer.clientWidth,
            clientHeight: this.mapContainer.clientHeight
        });
        
        // Create map HTML with explicit height
        console.log('🗺️ Setting innerHTML...');
        this.mapContainer.innerHTML = `<div id="map" style="height: 500px; width: 100%; background: #f0f0f0; border: 2px solid #ccc;"></div>`;
        
        console.log('🗺️ innerHTML set. New content:', this.mapContainer.innerHTML);
        
        // Load Mapbox and create map
        console.log('🗺️ Loading Mapbox...');
        this.loadMapbox().then(() => {
            console.log('🗺️ Mapbox loaded, initializing map...');
            this.initMap();
        }).catch(error => {
            console.error('❌ Error loading Mapbox:', error);
        });
    }

    loadMapbox() {
        console.log('🗺️ ===== LOAD MAPBOX =====');
        return new Promise((resolve, reject) => {
            // Load CSS
            console.log('🗺️ Checking for Mapbox CSS...');
            if (!document.querySelector('link[href*="mapbox-gl"]')) {
                console.log('🗺️ Loading Mapbox CSS...');
                const link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = 'https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css';
                document.head.appendChild(link);
                console.log('🗺️ Mapbox CSS loaded');
            } else {
                console.log('🗺️ Mapbox CSS already loaded');
            }

            // Load JS
            console.log('🗺️ Checking for Mapbox JS...');
            if (window.mapboxgl) {
                console.log('🗺️ Mapbox JS already loaded');
                mapboxgl.accessToken = this.mapboxAccessToken;
                resolve();
            } else {
                console.log('🗺️ Loading Mapbox JS...');
                const script = document.createElement('script');
                script.src = 'https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js';
                script.onload = () => {
                    console.log('🗺️ Mapbox JS loaded successfully');
                    mapboxgl.accessToken = this.mapboxAccessToken;
                    resolve();
                };
                script.onerror = (error) => {
                    console.error('❌ Error loading Mapbox JS:', error);
                    reject(error);
                };
                document.head.appendChild(script);
            }
        });
    }

    initMap() {
        console.log('🗺️ ===== INIT MAP =====');
        console.log('🗺️ Initializing map...');
        
        if (!window.mapboxgl) {
            console.error('❌ Mapbox not loaded');
            console.error('❌ window.mapboxgl:', window.mapboxgl);
            return;
        }

        console.log('🗺️ Mapbox loaded successfully, mapboxgl object:', window.mapboxgl);

        const mapElement = document.getElementById('map');
        console.log('🗺️ Map element found:', !!mapElement);
        console.log('🗺️ Map element:', mapElement);
        console.log('🗺️ Map element dimensions:', {
            width: mapElement?.offsetWidth,
            height: mapElement?.offsetHeight,
            clientWidth: mapElement?.clientWidth,
            clientHeight: mapElement?.clientHeight
        });

        if (!mapElement) {
            console.error('❌ Map element not found!');
            return;
        }

        try {
            console.log('🗺️ Creating Mapbox map...');
            
            // Determine center coordinates
            let centerLat = 47.7544;  // Default: Woodinville
            let centerLng = -122.1556;
            let zoomLevel = 13;
            
            if (this.parkData && this.parkData.latitude && this.parkData.longitude) {
                centerLat = parseFloat(this.parkData.latitude);
                centerLng = parseFloat(this.parkData.longitude);
                zoomLevel = 15; // Closer zoom for specific park
                console.log('🗺️ Using park coordinates:', centerLat, centerLng);
                console.log('🗺️ Park data latitude type:', typeof this.parkData.latitude, 'value:', this.parkData.latitude);
                console.log('🗺️ Park data longitude type:', typeof this.parkData.longitude, 'value:', this.parkData.longitude);
            } else {
                console.log('🗺️ Using default Woodinville coordinates');
                console.log('🗺️ Park data available:', !!this.parkData);
                if (this.parkData) {
                    console.log('🗺️ Park data:', this.parkData);
                }
            }
            
            // Create map
            const map = new mapboxgl.Map({
                container: 'map',
                style: 'mapbox://styles/mapbox/outdoors-v12', // Great for parks and outdoor activities
                center: [centerLng, centerLat], // Note: Mapbox uses [lng, lat] order
                zoom: zoomLevel
            });
            console.log('🗺️ Mapbox map created:', map);
            
            // Wait for map to load before adding markers
            map.on('load', () => {
                console.log('🗺️ Map loaded, adding markers...');
                this.addMarkers(map);
            });
            
            console.log('🗺️ Map created successfully');
            this.map = map;
            
            // Setup drop pin functionality
            this.setupDropPinMode();
            
            // Calculate distances if park data and saved address are available
            this.calculateDistances();
        } catch (error) {
            console.error('❌ Error creating map:', error);
        }
    }

    async addMarkers(map) {
        console.log('📍 ===== ADDING MARKERS =====');
        
        // Add park marker if park data is available
        if (this.parkData && this.parkData.latitude && this.parkData.longitude) {
            const markerLat = parseFloat(this.parkData.latitude);
            const markerLng = parseFloat(this.parkData.longitude);
            console.log('📍 Adding park marker at:', markerLat, markerLng);
            
            if (!isNaN(markerLat) && !isNaN(markerLng)) {
                // Create custom marker element for park
                const parkMarkerEl = document.createElement('div');
                parkMarkerEl.className = 'park-marker';
                parkMarkerEl.innerHTML = '🏞️';
                parkMarkerEl.style.fontSize = '24px';
                parkMarkerEl.style.cursor = 'pointer';
                
                const parkMarker = new mapboxgl.Marker(parkMarkerEl)
                    .setLngLat([markerLng, markerLat])
                    .setPopup(new mapboxgl.Popup({ offset: 25 })
                        .setHTML(`<h4>${this.parkData.name}</h4><p>${this.parkData.address}</p>`))
                    .addTo(map);
                
                this.markers.push(parkMarker);
                console.log('📍 Park marker added successfully');
            } else {
                console.error('❌ Invalid park marker coordinates:', markerLat, markerLng);
            }
        }
        
        // Add user address marker if user address is provided
        if (this.userAddress) {
            console.log('📍 Adding user address marker for:', this.userAddress);
            const userCoords = await this.geocodeAddress(this.userAddress);
            
            if (userCoords) {
                // Create custom marker element for user location
                const userMarkerEl = document.createElement('div');
                userMarkerEl.className = 'user-marker';
                userMarkerEl.innerHTML = '🏠';
                userMarkerEl.style.fontSize = '24px';
                userMarkerEl.style.cursor = 'pointer';
                
                const userMarker = new mapboxgl.Marker(userMarkerEl)
                    .setLngLat([userCoords.lng, userCoords.lat])
                    .setPopup(new mapboxgl.Popup({ offset: 25 })
                        .setHTML(`<h4>Your Location</h4><p>${this.userAddress}</p>`))
                    .addTo(map);
                
                this.markers.push(userMarker);
                console.log('📍 User address marker added successfully at:', userCoords);
                
                // If we have both markers, draw a route
                if (this.parkData && this.parkData.latitude && this.parkData.longitude) {
                    this.drawRoute(userCoords, {
                        lat: parseFloat(this.parkData.latitude),
                        lng: parseFloat(this.parkData.longitude)
                    });
                }
            } else {
                console.warn('⚠️ Could not geocode user address, skipping marker');
            }
        }
        
        // Fit map to show all markers
        if (this.markers.length > 1) {
            const bounds = new mapboxgl.LngLatBounds();
            this.markers.forEach(marker => {
                bounds.extend(marker.getLngLat());
            });
            map.fitBounds(bounds, { padding: 50 });
            console.log('📍 Map bounds adjusted to show all markers');
        }
        
        console.log('📍 Total markers added:', this.markers.length);
    }

    setupDropPinMode() {
        console.log('📍 ===== SETTING UP DROP PIN MODE =====');
        
        const dropPinBtn = document.getElementById('dropPinBtn');
        if (!dropPinBtn) {
            console.warn('⚠️ Drop pin button not found');
            return;
        }

        dropPinBtn.addEventListener('click', () => {
            this.toggleDropPinMode();
        });

        console.log('📍 Drop pin mode setup complete');
    }

    toggleDropPinMode() {
        console.log('📍 ===== TOGGLE DROP PIN MODE =====');
        
        this.dropPinMode = !this.dropPinMode;
        const dropPinBtn = document.getElementById('dropPinBtn');
        
        if (this.dropPinMode) {
            console.log('📍 Drop pin mode activated');
            dropPinBtn.classList.add('active');
            dropPinBtn.innerHTML = '<i class="fas fa-times"></i><span>Cancel</span>';
            
            // Change cursor to crosshair
            if (this.map) {
                this.map.getContainer().style.cursor = 'crosshair';
            }
            
            // Add click listener to map
            this.addMapClickListener();
        } else {
            console.log('📍 Drop pin mode deactivated');
            dropPinBtn.classList.remove('active');
            dropPinBtn.innerHTML = '<i class="fas fa-map-pin"></i><span>Drop Pin</span>';
            
            // Reset cursor
            if (this.map) {
                this.map.getContainer().style.cursor = '';
            }
            
            // Remove click listener
            this.removeMapClickListener();
        }
    }

    addMapClickListener() {
        if (this.map) {
            this.mapClickListener = (e) => {
                if (this.dropPinMode) {
                    this.dropPinAtLocation(e.latlng);
                }
            };
            this.map.on('click', this.mapClickListener);
        }
    }

    removeMapClickListener() {
        if (this.map && this.mapClickListener) {
            this.map.off('click', this.mapClickListener);
            this.mapClickListener = null;
        }
    }

    async dropPinAtLocation(latlng) {
        console.log('📍 ===== DROPPING PIN =====');
        console.log('📍 Location:', latlng);
        
        // Remove existing dropped pin
        if (this.droppedPin) {
            this.map.removeLayer(this.droppedPin);
            this.markers = this.markers.filter(marker => marker !== this.droppedPin);
        }
        
        // Create new dropped pin with different style
        this.droppedPin = L.marker([latlng.lat, latlng.lng], {
            icon: L.divIcon({
                className: 'dropped-pin',
                html: '<i class="fas fa-map-pin" style="color: #dc3545; font-size: 24px;"></i>',
                iconSize: [24, 24],
                iconAnchor: [12, 24]
            })
        }).addTo(this.map);
        
        this.markers.push(this.droppedPin);
        
        // Get address for this location
        const address = await this.reverseGeocode(latlng.lat, latlng.lng);
        
        // Show popup with address
        this.droppedPin.bindPopup(`
            <div style="text-align: center;">
                <h4 style="margin: 0 0 8px 0; color: #dc3545;">📍 Dropped Pin</h4>
                <p style="margin: 0 0 8px 0; font-weight: 500;">${address}</p>
                <p style="margin: 0; font-size: 0.9em; color: #666;">
                    Lat: ${latlng.lat.toFixed(6)}<br>
                    Lng: ${latlng.lng.toFixed(6)}
                </p>
            </div>
        `).openPopup();
        
        // Update distance calculations with new pin
        this.calculateDistancesFromDroppedPin(latlng);
        
        // Exit drop pin mode
        this.toggleDropPinMode();
        
        console.log('📍 Pin dropped successfully at:', address);
    }

    async reverseGeocode(lat, lng) {
        try {
            console.log('🔄 Reverse geocoding:', lat, lng);
            
            const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1`;
            
            // Add delay to respect rate limits
            await new Promise(resolve => setTimeout(resolve, 1000));
            
            const response = await fetch(url, {
                headers: {
                    'User-Agent': 'LivingInWoodenville/1.0'
                }
            });
            
            if (!response.ok) {
                throw new Error(`Reverse geocoding failed with status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log('🔄 Reverse geocoding response:', data);
            
            if (data && data.display_name) {
                return data.display_name;
            } else {
                return `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
            }
        } catch (error) {
            console.error('❌ Reverse geocoding error:', error);
            return `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
        }
    }

    calculateDistancesFromDroppedPin(latlng) {
        console.log('📏 ===== CALCULATING DISTANCES FROM DROPPED PIN =====');
        
        if (!this.parkData || !this.parkData.latitude || !this.parkData.longitude) {
            console.log('📏 No park coordinates available');
            return;
        }
        
        const parkLat = parseFloat(this.parkData.latitude);
        const parkLng = parseFloat(this.parkData.longitude);
        
        if (isNaN(parkLat) || isNaN(parkLng)) {
            console.error('❌ Invalid park coordinates:', parkLat, parkLng);
            return;
        }
        
        // Calculate straight-line distance
        const straightDistance = this.calculateStraightDistance(
            latlng.lat, latlng.lng, parkLat, parkLng
        );
        
        if (isNaN(straightDistance) || straightDistance <= 0) {
            console.error('❌ Invalid distance calculation:', straightDistance);
            return;
        }
        
        // Estimate driving distance and time
        const estimatedDrivingDistance = straightDistance * 1.3;
        const estimatedDrivingTime = (estimatedDrivingDistance / 30) * 60; // in minutes
        
        console.log('📏 Distance from dropped pin to park:', straightDistance, 'miles');
        console.log('🚗 Estimated driving distance:', estimatedDrivingDistance, 'miles');
        console.log('⏱️ Estimated driving time:', estimatedDrivingTime, 'minutes');
        
        // Update distance display
        this.updateDistanceDisplay(estimatedDrivingTime, estimatedDrivingDistance);
    }

    calculateDistances() {
        console.log('📏 Calculating distances...');
        
        if (!this.parkData || !this.parkData.latitude || !this.parkData.longitude) {
            console.log('📏 No park coordinates available');
            this.updateDistanceDisplay(null, null);
            return;
        }

        const savedAddress = localStorage.getItem('savedAddress');
        console.log('💾 Saved address from localStorage:', savedAddress);
        
        if (!savedAddress || savedAddress.trim() === '') {
            console.log('📏 No saved address found');
            this.updateDistanceDisplay(null, null);
            return;
        }

        console.log('📏 Calculating distance from:', savedAddress, 'to:', this.parkData.name);
        console.log('📏 Park coordinates:', this.parkData.latitude, this.parkData.longitude);
        
        this.getRouteInfo(savedAddress, this.parkData.latitude, this.parkData.longitude);
    }

    async getRouteInfo(fromAddress, toLat, toLng) {
        try {
            console.log('🛣️ Getting route info...');
            console.log('🛣️ From address:', fromAddress);
            console.log('🛣️ To coordinates (raw):', toLat, toLng);
            
            // Ensure coordinates are numbers
            const parkLat = parseFloat(toLat);
            const parkLng = parseFloat(toLng);
            
            console.log('🛣️ To coordinates (parsed):', parkLat, parkLng);
            
            if (isNaN(parkLat) || isNaN(parkLng)) {
                console.error('❌ Invalid park coordinates:', parkLat, parkLng);
                this.updateDistanceDisplay(null, null);
                return;
            }
            
            // First, geocode the from address
            console.log('🌍 Starting geocoding for address:', fromAddress);
            const fromCoords = await this.geocodeAddress(fromAddress);
            if (!fromCoords) {
                console.error('❌ Could not geocode address');
                console.log('📍 This may be due to the address not being in the geocoding database');
                console.log('📍 The address will use fallback coordinates for distance calculations');
                this.updateDistanceDisplay(null, null);
                return;
            }

            console.log('🛣️ From coordinates:', fromCoords);
            console.log('🛣️ To coordinates:', parkLat, parkLng);

            // Calculate straight-line distance
            const straightDistance = this.calculateStraightDistance(
                fromCoords.lat, fromCoords.lng, parkLat, parkLng
            );

            console.log('📏 Straight-line distance:', straightDistance, 'miles');

            if (isNaN(straightDistance) || straightDistance <= 0) {
                console.error('❌ Invalid distance calculation:', straightDistance);
                this.updateDistanceDisplay(null, null);
                return;
            }

            // Estimate driving distance (typically 1.2-1.4x straight distance)
            const estimatedDrivingDistance = straightDistance * 1.3;
            
            // Estimate driving time (assuming average speed of 30 mph in suburban areas)
            const estimatedDrivingTime = (estimatedDrivingDistance / 30) * 60; // in minutes

            console.log('🚗 Estimated driving distance:', estimatedDrivingDistance, 'miles');
            console.log('⏱️ Estimated driving time:', estimatedDrivingTime, 'minutes');

            this.updateDistanceDisplay(estimatedDrivingTime, estimatedDrivingDistance);

        } catch (error) {
            console.error('❌ Error calculating route:', error);
            this.updateDistanceDisplay(null, null);
        }
    }

    async geocodeAddress(address) {
        try {
            console.log('🌍 Geocoding address:', address);
            
            if (!address || address.trim() === '') {
                console.error('❌ Empty address provided');
                return null;
            }
            
            const cleanAddress = address.trim();
            
            // Try multiple address formats for better geocoding success
            const addressFormats = [
                cleanAddress, // Original format
                cleanAddress.replace(/,/g, ''), // Remove commas
                cleanAddress.replace(/SE/g, 'Southeast'), // Expand SE
                cleanAddress.replace(/SE/g, 'Southeast').replace(/,/g, ''), // Both modifications
                `${cleanAddress}, USA`, // Add country
                cleanAddress.replace(/229th Place SE/g, '229th Pl SE'), // Abbreviate Place
                cleanAddress.replace(/229th Place SE/g, '229th Place Southeast'), // Full expansion
                cleanAddress.replace(/229th Place SE/g, '229th Pl Southeast'), // Mixed abbreviation
                cleanAddress.replace(/229th Place SE/g, '229th Place S.E.'), // Period format
                cleanAddress.replace(/229th Place SE/g, '229th Pl S.E.'), // Abbreviated with periods
                cleanAddress.replace(/229th Place SE/g, '229th Place SE'), // Ensure consistent spacing
                cleanAddress.replace(/229th Place SE/g, '229th Pl SE').replace(/,/g, ''), // Abbreviated no commas
                cleanAddress.replace(/229th Place SE/g, '229th Place Southeast').replace(/,/g, ''), // Full expansion no commas
            ];
            
            // Remove duplicates
            const uniqueFormats = [...new Set(addressFormats)];
            
            for (let i = 0; i < uniqueFormats.length; i++) {
                const format = uniqueFormats[i];
                console.log(`🌍 Trying address format ${i + 1}/${uniqueFormats.length}:`, format);
                
                const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(format)}&limit=1&countrycodes=us&addressdetails=1`;
                
                // Add a small delay to respect Nominatim rate limits
                await new Promise(resolve => setTimeout(resolve, 1000));
                
                try {
                    const response = await fetch(url, {
                        headers: {
                            'User-Agent': 'LivingInWoodenville/1.0'
                        }
                    });
                    
                    console.log(`🌍 Geocoding response status for format ${i + 1}:`, response.status);
                    
                    if (response.ok) {
                        const data = await response.json();
                        console.log(`🌍 Geocoding response data for format ${i + 1}:`, data);
                        
                        if (data && data.length > 0) {
                            const result = data[0];
                            const coords = {
                                lat: parseFloat(result.lat),
                                lng: parseFloat(result.lon)
                            };
                            
                            console.log(`🌍 Geocoded coordinates for format ${i + 1}:`, coords);
                            
                            if (!isNaN(coords.lat) && !isNaN(coords.lng)) {
                                console.log(`✅ Successfully geocoded with format ${i + 1}:`, format);
                                return coords;
                            }
                        }
                    }
                } catch (formatError) {
                    console.warn(`⚠️ Error with format ${i + 1}:`, formatError.message);
                    continue;
                }
            }

            console.error('❌ No geocoding results found for any address format');
            console.log('🔍 This is common for newer developments or private roads not in OpenStreetMap');
            
            // Enhanced fallback approach for specific addresses
            if (cleanAddress.toLowerCase().includes('woodinville')) {
                console.log('🏠 Using Woodinville fallback coordinates');
                
                // Check if this is the specific address we know
                if (cleanAddress.includes('8127') && cleanAddress.includes('229th')) {
                    console.log('🏠 Using specific coordinates for 8127 229th Place SE');
                    console.log('📍 Note: This address may not be in OpenStreetMap database');
                    console.log('📍 Using approximate coordinates for the 229th Place SE area');
                    // These are more specific coordinates for the 229th Place SE area
                    // Based on the general location of 229th Place SE in Woodinville
                    return {
                        lat: 47.7520,
                        lng: -122.1580
                    };
                }
                
                // General Woodinville fallback
                console.log('🏠 Using general Woodinville coordinates');
                return {
                    lat: 47.7544,
                    lng: -122.1556
                };
            }
            
            return null;
        } catch (error) {
            console.error('❌ Geocoding error:', error);
            return null;
        }
    }

    calculateStraightDistance(lat1, lng1, lat2, lng2) {
        console.log('📐 Calculating distance between:', lat1, lng1, 'and', lat2, lng2);
        
        // Validate inputs
        const coords = [lat1, lng1, lat2, lng2].map(coord => parseFloat(coord));
        const [pLat1, pLng1, pLat2, pLng2] = coords;
        
        console.log('📐 Parsed coordinates:', pLat1, pLng1, pLat2, pLng2);
        
        if (coords.some(coord => isNaN(coord))) {
            console.error('❌ Invalid coordinates for distance calculation:', coords);
            return NaN;
        }
        
        const R = 3959; // Earth's radius in miles
        const dLat = this.degToRad(pLat2 - pLat1);
        const dLng = this.degToRad(pLng2 - pLng1);
        const a = 
            Math.sin(dLat/2) * Math.sin(dLat/2) +
            Math.cos(this.degToRad(pLat1)) * Math.cos(this.degToRad(pLat2)) * 
            Math.sin(dLng/2) * Math.sin(dLng/2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        const distance = R * c; // Distance in miles
        
        console.log('📐 Calculated distance:', distance, 'miles');
        return distance;
    }

    degToRad(deg) {
        return deg * (Math.PI/180);
    }

    updateDistanceDisplay(timeInMinutes, distanceInMiles) {
        console.log('📊 ===== UPDATE DISTANCE DISPLAY =====');
        console.log('📊 Updating distance display:', timeInMinutes, 'min,', distanceInMiles, 'mi');
        
        const travelTimeEl = document.getElementById('travelTime');
        const drivingDistanceEl = document.getElementById('drivingDistance');

        console.log('📊 Travel time element found:', !!travelTimeEl);
        console.log('📊 Driving distance element found:', !!drivingDistanceEl);
        
        if (!travelTimeEl || !drivingDistanceEl) {
            console.error('❌ Distance elements not found in DOM');
            console.log('📊 Available elements with IDs:', 
                Array.from(document.querySelectorAll('[id]')).map(el => el.id)
            );
            return;
        }

        if (travelTimeEl) {
            if (timeInMinutes === null || timeInMinutes === undefined || isNaN(timeInMinutes)) {
                travelTimeEl.textContent = 'n/a';
                console.log('📊 Travel time set to: n/a (no valid time)');
            } else {
                const hours = Math.floor(timeInMinutes / 60);
                const mins = Math.round(timeInMinutes % 60);
                
                let timeText;
                if (hours > 0) {
                    timeText = `${hours}h ${mins > 0 ? mins + 'm' : ''}`;
                } else {
                    timeText = `${mins} min`;
                }
                
                travelTimeEl.textContent = timeText;
                console.log('📊 Travel time updated to:', timeText);
            }
        }

        if (drivingDistanceEl) {
            if (distanceInMiles === null || distanceInMiles === undefined || isNaN(distanceInMiles)) {
                drivingDistanceEl.textContent = 'n/a';
                console.log('📊 Driving distance set to: n/a (no valid distance)');
            } else {
                const distanceText = `${distanceInMiles.toFixed(1)} mi`;
                drivingDistanceEl.textContent = distanceText;
                console.log('📊 Driving distance updated to:', distanceText);
            }
        }
        
        console.log('📊 ===== DISTANCE DISPLAY UPDATE COMPLETE =====');
    }
}